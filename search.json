{% assign docs = site.pisne | concat: site.poezie | concat: site.state | concat: site.obrazky %}[
{% for d in docs %}{% capture kdo %}{{ d.music }} {{ d.text }} {{ d.preklad | join: ", " }} {{ d.autor }}{% endcapture %}{"t":{{ d.title | default: d.name | jsonify }},"u":{{ d.url | downcase | jsonify }},"k":{{ d.collection | jsonify }},"a":{{ kdo | normalize_whitespace | jsonify }},"v":{{ d.vydal | jsonify }},"x":{{ d.content | strip_html | replace: "&nbsp;", " " | replace: "&amp;", "&" | replace: '&quot;', '"' | normalize_whitespace | jsonify }}}{% unless forloop.last %},
{% endunless %}{% endfor %}
]
